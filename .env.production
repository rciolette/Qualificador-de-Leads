# Build de produção. Versionado de propósito.
#
# Estes dois valores são PÚBLICOS por design: o Vite os embute no bundle JS, então
# qualquer visitante os lê no DevTools de qualquer forma. A publishable key não dá
# acesso a nada — quem protege os dados é a RLS do schema `qualificador`, que exige
# um papel em qualificador.user_profiles.
#
# Sem este arquivo, um build feito fora desta máquina (Cloudflare, CI) sai sem
# configuração e o app abre em branco.
VITE_SUPABASE_URL=https://qevnfgopjupsmwvflcza.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_yAF4GIwSNZ_l25l7s8Xs2g_iHmF8_TR
